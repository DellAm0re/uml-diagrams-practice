Teacher [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F5F9FF"><TR><TD BGCOLOR="#DCEBFF"><B>Teacher</B></TD></TR><TR><TD ALIGN="LEFT">- teacherId: int<BR ALIGN="LEFT"/>- fullName: str<BR ALIGN="LEFT"/>- department: str</TD></TR><TR><TD ALIGN="LEFT">+ assignGrade(): void<BR ALIGN="LEFT"/>+ viewLoad(): list</TD></TR></TABLE>>];
Discipline [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F5F9FF"><TR><TD BGCOLOR="#DCEBFF"><B>Discipline</B></TD></TR><TR><TD ALIGN="LEFT">- disciplineId: int<BR ALIGN="LEFT"/>- title: str<BR ALIGN="LEFT"/>- credits: int</TD></TR><TR><TD ALIGN="LEFT">+ getSyllabus(): str</TD></TR></TABLE>>];
CourseEnrollment [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F5F9FF"><TR><TD BGCOLOR="#DCEBFF"><B>CourseEnrollment</B></TD></TR><TR><TD ALIGN="LEFT">- enrollmentId: int<BR ALIGN="LEFT"/>- semester: int<BR ALIGN="LEFT"/>- grade: float</TD></TR><TR><TD ALIGN="LEFT">+ register(): void<BR ALIGN="LEFT"/>+ updateGrade(): void</TD></TR></TABLE>>];
 Student -> CourseEnrollment [arrowhead=none,taillabel="1",headlabel="0..*",label="реєструється",labeldistance=2];
 Discipline -> CourseEnrollment [arrowhead=none,taillabel="1",headlabel="0..*",label="має записи",labeldistance=2];
